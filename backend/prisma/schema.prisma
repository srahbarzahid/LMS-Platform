generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  UNPUBLISHED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id                      String    @id @default(uuid())
  name                    String
  email                   String    @unique
  phone                   String?
  password                String
  role                    Role      @default(STUDENT)
  profileImage            String?   @db.Text
  bio                     String?   @db.Text
  city                    String?
  country                 String?
  college                 String?
  occupation              String?
  skills                  Json?
  experienceLevel         String?
  githubUrl               String?   @db.Text
  linkedinUrl             String?   @db.Text
  portfolioUrl            String?   @db.Text
  pendingEmail            String?
  pendingPhone            String?
  isEmailVerified         Boolean   @default(true)
  isPhoneVerified         Boolean   @default(false)
  notificationPreferences Json?
  dateOfBirth             String?
  gender                  String?
  designation             String?
  isDeactivated           Boolean   @default(false)
  deactivatedAt           DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  courses            Course[]                @relation("InstructorCourses")
  enrollments        Enrollment[]
  cartItems          Cart[]
  wishlistItems      Wishlist[]
  payments           Payment[]
  reviews            Review[]
  submissions        Submission[]
  certificates       Certificate[]
  notifications      Notification[]
  courseCompletions  CourseCompletion[]
  projectSubmissions ProjectSubmission[]
  instructorProjects Project[]
  settings           UserSettings?
  notificationPrefs  NotificationPreference?
  securitySessions   SecuritySession[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  courses     Course[]
}

model Course {
  id               String       @id @default(uuid())
  title            String
  slug             String       @unique
  subtitle         String?      @db.Text
  description      String       @db.Text
  shortDescription String       @db.Text
  thumbnail        String?      @db.Text
  categoryId       String
  instructorId     String
  level            Level        @default(BEGINNER)
  language         String       @default("English")
  price            Float
  discountPrice    Float?
  duration         Int? // in minutes
  status           CourseStatus @default(DRAFT)
  featured         Boolean      @default(false)
  rating           Float        @default(0)
  totalStudents    Int          @default(0)
  certificateAvail Boolean      @default(true)
  learningOutcomes Json?
  requirements     Json?
  targetAudience   String?      @db.Text
  tags             Json?
  promoVideoUrl    String?      @db.Text
  rejectionReason  String?      @db.Text
  submittedAt      DateTime?
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  category          Category           @relation(fields: [categoryId], references: [id])
  instructor        User               @relation("InstructorCourses", fields: [instructorId], references: [id])
  modules           Module[]
  enrollments       Enrollment[]
  cartItems         Cart[]
  wishlistItems     Wishlist[]
  payments          Payment[]
  reviews           Review[]
  quizzes           Quiz[]
  assignments       Assignment[]
  projects          Project[]
  certificates      Certificate[]
  courseCompletions CourseCompletion[]
}

model Module {
  id       String   @id @default(uuid())
  courseId String
  title    String
  order    Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

model Lesson {
  id          String  @id @default(uuid())
  moduleId    String
  title       String
  description String? @db.Text
  videoUrl    String? @db.Text
  duration    Int? // in minutes
  isPreview   Boolean @default(false)
  order       Int
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  paymentId String?
  progress  Float    @default(0) // Percentage 0-100
  status    String   @default("ACTIVE") // ACTIVE, COMPLETED
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  courseId          String
  amount            Float
  status            PaymentStatus @default(PENDING)
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  rating    Int
  title     String?
  comment   String?  @db.Text
  status    String   @default("Published") // Published, Hidden
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Quiz {
  id               String     @id @default(uuid())
  courseId         String
  moduleId         String?
  title            String
  marksPerQuestion Int        @default(10)
  passingMarks     Int?
  course           Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions        Question[]
}

model Question {
  id            String @id @default(uuid())
  quizId        String
  question      String @db.Text
  options       Json // Stored as JSON array
  correctAnswer String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Assignment {
  id            String       @id @default(uuid())
  courseId      String
  moduleId      String?
  title         String
  description   String       @db.Text
  points        Float        @default(100)
  dueDate       DateTime?
  attachmentUrl String?      @db.Text
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions   Submission[]
}

model Submission {
  id           String   @id @default(uuid())
  assignmentId String
  userId       String
  fileUrl      String?  @db.Text
  comment      String?  @db.Text
  marks        Float?
  feedback     String?  @db.Text
  status       String   @default("SUBMITTED") // SUBMITTED, GRADED
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certificate {
  id              String    @id @default(uuid())
  certificateId   String    @unique
  userId          String
  courseId        String
  instructorId    String?
  completionDate  DateTime?
  issuedDate      DateTime  @default(now())
  certificateUrl  String?   @db.Text
  qrCodeUrl       String?   @db.Text
  verificationUrl String?   @db.Text
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseCompletion {
  id                  String    @id @default(uuid())
  userId              String
  courseId            String
  lessonProgress      Int       @default(0)
  quizCompleted       Boolean   @default(false)
  assignmentCompleted Boolean   @default(false)
  projectCompleted    Boolean   @default(false)
  overallProgress     Int       @default(0)
  isCompleted         Boolean   @default(false)
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Project {
  id                String    @id @default(uuid())
  courseId          String
  moduleId          String?
  instructorId      String
  title             String
  description       String    @db.Text
  projectFileUrl    String?   @db.Text
  projectFileType   String?
  dueDate           DateTime?
  maxMarks          Float     @default(100)
  allowResubmission Boolean   @default(false)
  status            String    @default("PUBLISHED")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor  User                @relation(fields: [instructorId], references: [id])
  submissions ProjectSubmission[]
}

model ProjectSubmission {
  id                String    @id @default(uuid())
  projectId         String
  studentId         String
  submittedFileUrl  String?   @db.Text
  submittedFileType String?
  submittedLink     String?   @db.Text
  studentNote       String?   @db.Text
  status            String    @default("PENDING") // PENDING, SUBMITTED, UNDER_REVIEW, GRADED, RESUBMISSION_REQUIRED
  marks             Float?
  feedback          String?   @db.Text
  submittedAt       DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  message     String   @db.Text
  category    String   @default("General") // Course Updates, Assignments, etc.
  type        String?
  relatedId   String?
  relatedType String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  preferredLanguage    String   @default("English")
  defaultPlaybackSpeed Float    @default(1.0)
  autoPlayNextLesson   Boolean  @default(true)
  resumePlayback       Boolean  @default(true)
  theme                String   @default("System") // Light, Dark, System
  accountVisibility    String   @default("Public") // Public, Private
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  courseUpdates            Boolean  @default(true)
  assignmentNotifications  Boolean  @default(true)
  quizNotifications        Boolean  @default(true)
  projectNotifications     Boolean  @default(true)
  certificateNotifications Boolean  @default(true)
  paymentNotifications     Boolean  @default(true)
  marketingEmails          Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecuritySession {
  id           String   @id @default(uuid())
  userId       String
  device       String
  browser      String?  @default("Chrome")
  location     String
  ipAddress    String
  isCurrent    Boolean  @default(false)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformSettings {
  id              String   @id @default("default")
  lmsName         String   @default("LMS Platform")
  logoUrl         String?  @db.Text
  defaultLanguage String   @default("English")
  defaultTheme    String   @default("System")
  supportEmail    String   @default("support@lms.com")
  supportPhone    String   @default("+1-800-555-0199")
  sessionTimeout  Int      @default(60)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
